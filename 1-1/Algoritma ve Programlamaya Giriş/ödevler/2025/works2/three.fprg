    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="na" type="Integer" array="False" size=""/>
            <declare name="an" type="Integer" array="False" size=""/>
            <for variable="na" start="1" end="10" direction="inc" step="1">
                <for variable="an" start="0" end="10" direction="inc" step="1">
