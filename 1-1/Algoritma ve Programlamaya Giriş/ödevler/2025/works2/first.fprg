    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="degerbir" type="Integer" array="False" size=""/>
            <declare name="degeriki" type="Integer" array="False" size=""/>
            <declare name="toplam" type="Integer" array="False" size=""/>
            <output expression="&quot;say&#305; 1 = ?&quot;" newline="True"/>
            <input variable="degerbir"/>
            <output expression="&quot;say&#305; 2 = ?&quot;" newline="True"/>
            <input variable="degeriki"/>
            <assign variable="toplam" expression="degerbir*degerbir + degeriki*degeriki"/>
            <output expression="toplam" newline="True"/>
        </body>
    </function>
