<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ikinci_soru"/>
        <attribute name="authors" value="mehmet"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-10-03 07:53:04 &#214;S"/>
